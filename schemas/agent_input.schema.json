{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentInput",
  "type": "object",
  "required": ["task", "input"],
  "properties": {
    "task": { "type": "string", "description": "Task name (generate, summarize, classify)" },
    "input": { "type": ["string", "object"], "description": "Task-specific input payload" },
    "params": { "type": "object", "description": "Optional parameters for generation", "additionalProperties": true }
  },
  "additionalProperties": false
}
